#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=95
STOP=10
USE_PROCD=1
start_service() {
	/usr/sbin/mf297d-ttl apply || logger -t mf297d-ttl 'Apply failed; check TTL page status'
	procd_open_instance
	procd_set_param command /usr/sbin/mf297d-ttl watch
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
reload_service() { /usr/sbin/mf297d-ttl apply; }
stop_service() { /usr/sbin/mf297d-ttl stop; }
service_triggers() { procd_add_reload_trigger 'mf297d-ttl'; }
